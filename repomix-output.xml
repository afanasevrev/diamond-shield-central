        localServer.setLastSeenAt(LocalDateTime.now());

        LocalServer saved = localServerRepository.save(localServer);

        return new LocalServerHeartbeatResponse(
                saved.getId(),
                saved.getStatus(),
                LocalDateTime.now()
        );
    }
